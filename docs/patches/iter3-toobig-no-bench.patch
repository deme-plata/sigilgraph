-fn zstd_decompress_body(body: &[u8]) -> Option<Vec<u8>> {
+/// Outcome of decoding a `'Z'` (zstd) chunk body. `TooBig` is an HONEST chunk that
+/// merely exceeded our local bomb-cap — it must NOT be treated like a malicious or
+/// garbage response. Callers on the frontier-advance path shrink the request window
+/// and retry the SAME peer on `TooBig`; only `Bad`/parse failures justify a bench.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Decoded {
+    Ok(Vec<u8>),
+    TooBig,   // hit MAX_OUT bomb-cap — honest, just larger than our ceiling
+}
+
+/// Cap-checked zstd decode. Returns `TooBig` (not `None`) when the stream would
+/// exceed `MAX_OUT`, so the caller can distinguish "shrink+retry" from "bench".
+fn zstd_decode_checked(body: &[u8]) -> Decoded {
+    use std::io::Read;
+    const MAX_OUT: u64 = 64 * 1024 * 1024;
+    let Some(mut dec) = ruzstd::StreamingDecoder::new(body).ok() else { return Decoded::TooBig };
+    let mut out = Vec::new();
+    if dec.take(MAX_OUT + 1).read_to_end(&mut out).is_err() { return Decoded::TooBig; }
+    if out.len() as u64 > MAX_OUT { return Decoded::TooBig; } // honest-too-big, NOT a bench-worthy fault
+    Decoded::Ok(out)
+}
+
+/// Thin Option wrapper for the probe paths (height seed / display), which never
+/// bench or stall the frontier — a miss there is harmless.
+fn zstd_decompress_body(body: &[u8]) -> Option<Vec<u8>> {
     use std::io::Read;
     const MAX_OUT: u64 = 64 * 1024 * 1024;
     let mut dec = ruzstd::StreamingDecoder::new(body).ok()?;
     let mut out = Vec::new();
     dec.take(MAX_OUT + 1).read_to_end(&mut out).ok()?;
     if out.len() as u64 > MAX_OUT { return None; } // bomb guard
     Some(out)
 }
@@
