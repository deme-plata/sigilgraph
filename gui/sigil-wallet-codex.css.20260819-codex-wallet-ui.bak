/*
 * SIGIL Wallet — Codex visual pass
 * Loaded after the production inline styles so wallet logic remains untouched.
 */

:root {
  --bg: #070a09;
  --cyan: #73e5c2;
  --cyan-bright: #b4f3df;
  --cm: #5b9cff;
  --teal: #10a37f;
  --violet: #8c7cf4;
  --grid: rgba(125, 227, 195, 0.1);
  --glow: rgba(16, 163, 127, 0.34);
  --gold: #f4b860;
  --orange: #ff8a70;
  --line: rgba(125, 227, 195, 0.17);
  --text: #eef6f2;
  --dim: #7c9188;
}

html {
  color-scheme: dark;
  overflow: hidden;
}

* {
  scrollbar-color: rgba(125, 227, 195, 0.46) rgba(7, 10, 9, 0.6);
}

::-webkit-scrollbar-track {
  background: rgba(7, 10, 9, 0.66);
  box-shadow: inset 1px 0 rgba(125, 227, 195, 0.09);
}

::-webkit-scrollbar-thumb {
  border-color: #070a09;
  background: linear-gradient(180deg, #9aecd2, #10a37f 66%, #4d8dff);
  box-shadow: 0 0 10px rgba(16, 163, 127, 0.4);
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #c8f8e8, #42cba5 66%, #6ca4ff);
  box-shadow: 0 0 15px rgba(125, 227, 195, 0.52);
}

body {
  color: var(--text);
  background: #070a09;
  font-family: "Segoe UI", Inter, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

::selection {
  color: #04110d;
  background: var(--cyan);
}

a,
button,
input,
.act,
.avatar,
.pill,
.agentbtn,
.snav a {
  -webkit-tap-highlight-color: transparent;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
.act:focus-visible,
.avatar:focus-visible,
.pill:focus-visible,
.snav a:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 3px;
}

.scene {
  background:
    radial-gradient(66% 52% at 2% -5%, rgba(16, 163, 127, 0.21), transparent 70%),
    radial-gradient(52% 44% at 98% 2%, rgba(78, 139, 255, 0.14), transparent 72%),
    radial-gradient(46% 38% at 52% 102%, rgba(140, 124, 244, 0.1), transparent 72%),
    linear-gradient(180deg, #09100d 0%, #070a09 52%, #080b0a 100%);
}

.scene::before {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  background-image:
    linear-gradient(rgba(125, 227, 195, 0.024) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 227, 195, 0.024) 1px, transparent 1px);
  background-size: 58px 58px;
  -webkit-mask-image: radial-gradient(ellipse 84% 76% at 52% 24%, #000 10%, transparent 78%);
  mask-image: radial-gradient(ellipse 84% 76% at 52% 24%, #000 10%, transparent 78%);
}

.scene::after {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  opacity: 0.32;
  background: repeating-linear-gradient(112deg, transparent 0 23px, rgba(255, 255, 255, 0.008) 24px 25px);
}

.aurora {
  opacity: 0.28;
  filter: blur(92px);
}

.aurora i:nth-child(1) {
  background: radial-gradient(circle, #10a37f, transparent 65%);
}

.aurora i:nth-child(2) {
  background: radial-gradient(circle, #4d8dff, transparent 65%);
}

.aurora i:nth-child(3) {
  background: radial-gradient(circle, #8c7cf4, transparent 62%);
  opacity: 0.44;
}

.markimg {
  filter: drop-shadow(0 0 13px rgba(125, 227, 195, 0.35));
}

.brand {
  color: #f5faf7;
  letter-spacing: 1.5px;
}

.brand span {
  color: var(--cyan);
}

.net {
  color: #8be9cb;
  border-color: rgba(125, 227, 195, 0.3);
  background: rgba(16, 163, 127, 0.08);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
}

.lic {
  color: var(--cyan);
  filter: drop-shadow(0 0 6px rgba(16, 163, 127, 0.32));
}

.pill {
  color: #9fb1aa;
  border-color: rgba(125, 227, 195, 0.17);
  background: linear-gradient(180deg, rgba(23, 34, 29, 0.92), rgba(11, 18, 15, 0.92));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
}

.pill b {
  color: var(--cyan-bright);
}

.vbadge {
  color: #ffd08b;
  border-color: rgba(244, 184, 96, 0.32);
  background: rgba(244, 184, 96, 0.075);
}

.vbadge .lic {
  color: var(--gold);
}

.amtbig {
  background-image: linear-gradient(105deg, #b4f3df 0%, #58d0ab 44%, #71a9ff 78%, #f4b860 122%);
  filter: drop-shadow(0 0 18px rgba(16, 163, 127, 0.22));
}

.heroaddr {
  color: #91a59c;
  border-color: rgba(125, 227, 195, 0.16);
  background: rgba(5, 12, 9, 0.42);
}

.heroaddr:hover {
  color: var(--cyan-bright);
  border-color: rgba(125, 227, 195, 0.5);
  box-shadow: 0 0 20px rgba(16, 163, 127, 0.18);
}

/* Desktop shell */
.gbar {
  height: 68px;
  padding-inline: 22px;
  border-bottom-color: rgba(125, 227, 195, 0.15);
  background: linear-gradient(180deg, rgba(8, 14, 11, 0.94), rgba(7, 11, 9, 0.86));
  box-shadow: 0 16px 42px rgba(0, 0, 0, 0.2);
  -webkit-backdrop-filter: blur(18px) saturate(135%);
  backdrop-filter: blur(18px) saturate(135%);
}

.gbar .logo img {
  width: 42px;
  height: 42px;
}

.gbar .logo .brand {
  font-size: 19px;
}

.search {
  max-width: 490px;
  min-height: 40px;
  border-color: rgba(125, 227, 195, 0.17);
  background:
    linear-gradient(180deg, rgba(20, 31, 26, 0.82), rgba(10, 17, 14, 0.86));
  color: #7f938a;
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
}

.search:hover {
  border-color: rgba(125, 227, 195, 0.43);
  box-shadow: 0 0 24px rgba(16, 163, 127, 0.12);
}

.search:focus-within {
  box-shadow: 0 0 0 3px rgba(16, 163, 127, 0.11), 0 0 25px rgba(16, 163, 127, 0.1);
}

.search::before {
  background: linear-gradient(120deg, var(--cyan), #5b9cff, var(--gold), var(--teal));
}

.search kbd {
  color: #8ea198;
  border-color: rgba(125, 227, 195, 0.15);
  background: rgba(255, 255, 255, 0.035);
}

.wdrop,
.pmenu {
  border-color: rgba(125, 227, 195, 0.26);
  background:
    radial-gradient(100% 80% at 100% 0%, rgba(78, 139, 255, 0.08), transparent 60%),
    linear-gradient(155deg, rgba(17, 27, 22, 0.985), rgba(7, 12, 9, 0.985));
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.62), 0 0 36px rgba(16, 163, 127, 0.08);
}

.avatar,
.pmenu .phd .pav {
  color: #04110d;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: linear-gradient(145deg, #9cedd3 0%, #10a37f 52%, #4d8dff 112%);
  box-shadow: 0 0 0 4px rgba(16, 163, 127, 0.07), 0 0 24px rgba(16, 163, 127, 0.22);
}

.avatar:hover {
  box-shadow: 0 0 0 4px rgba(16, 163, 127, 0.1), 0 0 28px rgba(16, 163, 127, 0.35);
}

.collapse,
.exback {
  color: var(--cyan-bright);
  border-color: rgba(125, 227, 195, 0.2);
  background: linear-gradient(180deg, rgba(23, 34, 29, 0.92), rgba(11, 18, 15, 0.92));
  transition: transform 0.16s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.collapse:hover,
.exback:hover {
  transform: translateY(-1px);
  border-color: rgba(125, 227, 195, 0.5);
  box-shadow: 0 0 20px rgba(16, 163, 127, 0.16);
}

.dwrap {
  background:
    radial-gradient(60% 65% at 66% 0%, rgba(16, 163, 127, 0.065), transparent 72%),
    radial-gradient(48% 56% at 100% 50%, rgba(78, 139, 255, 0.045), transparent 74%);
}

.side {
  width: 258px;
  padding: 20px 15px 16px;
  border-right-color: rgba(125, 227, 195, 0.14);
  background:
    linear-gradient(rgba(125, 227, 195, 0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 227, 195, 0.018) 1px, transparent 1px),
    linear-gradient(180deg, rgba(15, 28, 22, 0.82), rgba(7, 11, 9, 0.94) 74%);
  background-size: 36px 36px, 36px 36px, auto;
  box-shadow: 16px 0 44px rgba(0, 0, 0, 0.12);
}

.snav {
  margin-top: 2px;
  gap: 4px;
}

.snav a {
  min-height: 42px;
  padding: 10px 13px;
  border: 1px solid transparent;
  color: #83978e;
  font-family: "Segoe UI", Inter, system-ui, sans-serif;
  font-size: 14px;
  font-weight: 650;
  transition: transform 0.16s ease, color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
}

.snav a .lic {
  color: #6f857b;
}

.snav a:hover {
  color: #eef6f2;
  border-color: rgba(125, 227, 195, 0.09);
  background: rgba(125, 227, 195, 0.045);
  transform: translateX(3px);
}

.snav a.on {
  color: #bdf5e3;
  border-color: rgba(125, 227, 195, 0.18);
  background:
    linear-gradient(90deg, rgba(16, 163, 127, 0.19), rgba(78, 139, 255, 0.055) 76%, transparent);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025), 0 8px 20px rgba(0, 0, 0, 0.12);
}

.snav a.on .lic {
  color: var(--cyan-bright);
  filter: drop-shadow(0 0 9px rgba(125, 227, 195, 0.34));
}

.snav a.on::before {
  background: linear-gradient(180deg, var(--cyan), #5b9cff);
  box-shadow: 0 0 14px rgba(125, 227, 195, 0.58);
}

.snav .grp {
  color: #6b8177;
  margin-top: 13px;
  letter-spacing: 2.3px;
}

.soonchip {
  color: #ffd08b;
  border-color: rgba(244, 184, 96, 0.34);
  background: rgba(244, 184, 96, 0.055);
}

.sfoot {
  border-top-color: rgba(125, 227, 195, 0.13);
}

.agentbtn {
  border-color: rgba(244, 184, 96, 0.28);
  background:
    radial-gradient(90% 120% at 100% 0%, rgba(78, 139, 255, 0.08), transparent 68%),
    linear-gradient(135deg, rgba(244, 184, 96, 0.075), rgba(16, 163, 127, 0.055));
}

.agentbtn:hover {
  border-color: rgba(244, 184, 96, 0.5);
  box-shadow: 0 0 24px rgba(244, 184, 96, 0.12), 0 0 34px rgba(16, 163, 127, 0.06);
}

.agentbtn .at {
  color: #ffd08b;
}

.dmain {
  padding: 34px 40px;
  background-image:
    linear-gradient(rgba(125, 227, 195, 0.014) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 227, 195, 0.014) 1px, transparent 1px);
  background-size: 64px 64px;
}

.dhero {
  align-items: center;
  padding: 4px 2px 2px;
}

.dhero .lab {
  color: #7f938a;
}

.dhero .amt {
  font-size: clamp(50px, 5vw, 68px);
  letter-spacing: -1.5px;
}

.dactions {
  gap: 10px;
}

.act {
  position: relative;
  overflow: hidden;
  border-color: rgba(125, 227, 195, 0.17);
  background:
    radial-gradient(100% 120% at 100% 0%, rgba(78, 139, 255, 0.075), transparent 65%),
    linear-gradient(155deg, rgba(22, 34, 29, 0.94), rgba(9, 16, 12, 0.92));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.act::before {
  position: absolute;
  top: 0;
  right: 18%;
  left: 18%;
  height: 1px;
  content: "";
  opacity: 0;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  transition: opacity 0.18s ease;
}

.act:hover {
  border-color: rgba(125, 227, 195, 0.42);
  background:
    radial-gradient(100% 120% at 100% 0%, rgba(78, 139, 255, 0.1), transparent 65%),
    linear-gradient(155deg, rgba(28, 45, 37, 0.96), rgba(10, 19, 14, 0.94));
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24), 0 0 24px rgba(16, 163, 127, 0.11);
}

.act:hover::before {
  opacity: 1;
}

.dactions .act {
  min-width: 88px;
  padding: 13px 18px;
}

.dactions .act .t {
  font-family: "Segoe UI", Inter, system-ui, sans-serif;
  font-size: 13px;
}

.dgrid {
  grid-template-columns: minmax(0, 1.55fr) minmax(310px, 1fr);
  gap: 18px;
  margin-top: 30px;
}

.card,
.sidecard,
.rl-card {
  position: relative;
  overflow: hidden;
  border-color: rgba(125, 227, 195, 0.16);
  background:
    radial-gradient(100% 100% at 100% 0%, rgba(78, 139, 255, 0.06), transparent 64%),
    linear-gradient(155deg, rgba(18, 29, 24, 0.9), rgba(8, 14, 10, 0.88));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.028), 0 12px 36px rgba(0, 0, 0, 0.13);
}

.card::before,
.sidecard::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 1px;
  content: "";
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(125, 227, 195, 0.4), rgba(78, 139, 255, 0.24), transparent);
}

.card {
  min-height: 132px;
  border-radius: 16px;
  padding: 20px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.card:hover {
  border-color: rgba(125, 227, 195, 0.29);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.035), 0 18px 42px rgba(0, 0, 0, 0.2), 0 0 30px rgba(16, 163, 127, 0.045);
}

.sect {
  color: #7c9188;
  font-size: 9.5px;
  letter-spacing: 2.2px;
}

.row {
  border-color: rgba(125, 227, 195, 0.11);
  background:
    linear-gradient(90deg, rgba(16, 163, 127, 0.07), rgba(78, 139, 255, 0.025) 68%, transparent);
  transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
}

.row:hover {
  border-color: rgba(125, 227, 195, 0.25);
  background: linear-gradient(90deg, rgba(16, 163, 127, 0.11), rgba(78, 139, 255, 0.04) 70%, transparent);
  transform: translateY(-1px);
}

.row .coin {
  color: #04110d;
  background: linear-gradient(145deg, #9cedd3, #10a37f 58%, #4d8dff 125%) !important;
  box-shadow: 0 0 24px rgba(16, 163, 127, 0.16);
}

.exbar {
  border-bottom-color: rgba(125, 227, 195, 0.14);
  background: rgba(8, 14, 11, 0.94);
  -webkit-backdrop-filter: blur(15px);
  backdrop-filter: blur(15px);
}

/* Phone shell */
body:not(.view-desktop) {
  padding: 14px;
}

.phone {
  width: min(390px, calc(100vw - 28px));
  height: min(820px, calc(100vh - 28px));
  border-color: rgba(125, 227, 195, 0.21);
  background:
    radial-gradient(110% 74% at 100% 0%, rgba(78, 139, 255, 0.08), transparent 62%),
    linear-gradient(180deg, #0d1713, #070d0a 58%, #070a09);
  box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.56), 0 28px 90px rgba(0, 0, 0, 0.5), 0 0 54px rgba(16, 163, 127, 0.13);
}

.notch {
  border-color: rgba(125, 227, 195, 0.16);
  background: #070a09;
}

.statusbar {
  color: #74897f;
}

.statusbar b {
  color: var(--cyan);
}

.balance {
  border-color: rgba(125, 227, 195, 0.19);
  background:
    radial-gradient(90% 120% at 100% 0%, rgba(78, 139, 255, 0.1), transparent 65%),
    linear-gradient(155deg, rgba(16, 163, 127, 0.13), rgba(10, 22, 16, 0.58));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.035), 0 16px 34px rgba(0, 0, 0, 0.15);
}

.balance .lab {
  color: #7c9188;
}

.balance .sub {
  color: #7de3c3;
}

.actions .act {
  min-height: 82px;
  border-radius: 14px;
}

.nav {
  border-top-color: rgba(125, 227, 195, 0.14);
  background: linear-gradient(180deg, rgba(7, 12, 9, 0.15), rgba(7, 10, 9, 0.8));
}

.nav div {
  color: #71867c;
}

.nav div.on {
  color: var(--cyan-bright);
}

.expand {
  color: #ffd08b;
  border-color: rgba(244, 184, 96, 0.3);
  background: rgba(244, 184, 96, 0.075);
}

.caption {
  color: #6f8279;
}

.caption b {
  color: var(--cyan);
}

@media (max-width: 1100px) {
  .gbar {
    gap: 10px;
    padding-inline: 16px;
  }

  .gbar .logo .brand {
    font-size: 16px;
  }

  .search {
    max-width: 360px;
  }

  .gright {
    gap: 7px;
  }

  .gright .pill[title^="network hashrate"] {
    display: none;
  }

  .side {
    width: 226px;
  }

  .dmain {
    padding: 28px;
  }

  .dgrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 820px) {
  body.view-desktop .desktop {
    min-width: 720px;
  }
}

@media (max-width: 430px), (max-height: 760px) {
  body:not(.view-desktop) {
    padding: 0;
  }

  .phone {
    width: 100vw;
    height: 100vh;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .caption {
    display: none;
  }

  .balance {
    margin-top: 2px;
    padding-block: 18px;
  }

  .balance .amt {
    font-size: 36px;
  }

  .actions {
    margin-top: 13px;
  }

  .actions .act {
    min-height: 72px;
    padding-block: 10px;
  }

  .actions .act .lic {
    width: 34px;
    height: 34px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}
